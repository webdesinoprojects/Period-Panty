# Copy to .env on the server and fill in. .env is gitignored and must never be
# committed - it holds live credentials.

# Internal port. nginx proxies to 127.0.0.1:APP_PORT; nothing public binds here.
APP_PORT=8082

# Database. These create the in-container MariaDB user on first boot, and are
# handed to PHP by the entrypoint. Use a fresh password, not the old one from
# git history.
DB_NAME=dexte
DB_USER=dexte
DB_PASS=CHANGE_ME

# Razorpay. Rotate these before going live: the previous pair was committed to
# git history and must be treated as compromised.
RAZOR_KEY_ID=
RAZOR_KEY_SECRET=
